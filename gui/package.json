{
  "name": "textts-gui",
  "version": "1.0.0",
  "private": true,
  "description": "Giao diện soạn và tạo hội thoại TTS tiếng Nhật (Electron + React)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "test": "node --test test/*.test.cjs && vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run bundle:python && vite build && electron-builder --win nsis --publish never",
    "bundle:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-python.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "vn.textts.app",
    "productName": "textts",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "engine",
        "filter": [
          "tts.py",
          "core/**/*.py",
          "providers/**/*.py",
          "roles.yaml",
          "readings.example.yaml",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "python-runtime/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "python-runtime/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "miyagitaisuki",
        "repo": "textts"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "textts-${version}-setup.${ext}"
    }
  }
}
